rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profils publics (nécessaires pour le flux de découverte). Chacun ne
    // modifie / supprime que son propre profil.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Likes (y compris super likes via le champ "type").
    match /likes/{likeId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId;
      // toUserId supprime en acceptant un match (voir LikesScreen) ; fromUserId
      // supprime quand il annule son propre swipe ("Rewind").
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.toUserId || request.auth.uid == resource.data.fromUserId);
    }

    // Matchs persistés : seules les deux personnes concernées y accèdent.
    match /matches/{matchId} {
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
    }

    // Messages de chat, un uid doit faire partie de l'id "{uid1}_{uid2}".
    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null && request.auth.uid in chatId.split('_');
      allow create: if request.auth != null && request.auth.uid in chatId.split('_') &&
        request.auth.uid == request.resource.data.senderId;
      // Suppression façon WhatsApp : "pour moi" (n'importe quel participant
      // ajoute juste son propre uid à deletedFor) ou "pour tout le monde"
      // (seul l'auteur du message peut le faire). Le contenu du message
      // (texte/audio/expéditeur/date) ne peut jamais être modifié.
      allow update: if request.auth != null && request.auth.uid in chatId.split('_') &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.timestamp == resource.data.timestamp &&
        request.resource.data.get('text', null) == resource.data.get('text', null) &&
        request.resource.data.get('audioUrl', null) == resource.data.get('audioUrl', null) &&
        (
          (
            request.resource.data.deletedFor is list &&
            request.resource.data.deletedFor.hasOnly(resource.data.get('deletedFor', []).concat([request.auth.uid])) &&
            request.resource.data.get('deletedForEveryone', false) == resource.data.get('deletedForEveryone', false)
          ) ||
          (
            request.auth.uid == resource.data.senderId &&
            request.resource.data.deletedForEveryone == true &&
            request.resource.data.get('deletedFor', []) == resource.data.get('deletedFor', [])
          )
        );
    }
    // Conversation privée avec l'assistant IA : uniquement son propriétaire.
    match /aiAssistant/{userId}/messages/{messageId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Blocages : lisible par les deux parties, créé seulement par le bloqueur.
    match /blocks/{blockId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.blockerId || request.auth.uid == resource.data.blockedId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.blockerId;
    }

    // Signalements : écriture seule côté client, jamais relus (modération via la console).
    match /reports/{reportId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterId;
      allow read: if false;
    }

    // Feedback de déconnexion : écriture seule.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if false;
    }
  }
}
